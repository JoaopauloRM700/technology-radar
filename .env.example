# Porta HTTP da API (Render e local)
PORT=8787

# Token administrativo (minimo 32 caracteres, guardado apenas no backend)
ADMIN_TOKEN=

# Fine-grained PAT do GitHub restrito ao repositorio com permissao Contents: write
GITHUB_TOKEN=
GITHUB_OWNER=JoaopauloRM700
GITHUB_REPO=technology-radar
GITHUB_BRANCH=main

# Origens CORS permitidas separadas por virgula
ALLOWED_ORIGINS=https://joapaulorm700.github.io,http://localhost:4173

# Chave e endpoints/modelos NVIDIA NIM (somente backend)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_PARSE_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-parse/parse
